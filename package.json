{
  "name": "drover",
  "version": "0.1.0",
  "description": "Config-driven simulation harness that runs AI-driven personas through a web app to surface bugs, confusing flows, and performance problems.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests scripts examples",
    "lint:fix": "biome check --write src tests scripts examples",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:actor": "tsx scripts/smoke-actor.ts",
    "smoke:orchestrator": "tsx scripts/smoke-orchestrator.ts",
    "smoke:analyst": "tsx scripts/smoke-analyst.ts",
    "smoke:stampede": "tsx scripts/smoke-stampede.ts",
    "preflight:hhops": "tsx scripts/preflight-hhops.ts",
    "drover": "tsx src/cli/index.ts",
    "example:serve": "tsx examples/toy-app/site-server.ts"
  },
  "keywords": [
    "qa",
    "simulation",
    "testing",
    "playwright",
    "llm",
    "personas"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "drover": "./dist/cli/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
